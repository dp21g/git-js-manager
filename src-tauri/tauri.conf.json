{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Git Squash UI",
  "version": "1.0.0",
  "identifier": "com.git.squash.ui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run tauri:prepare && npm run dev:web",
    "beforeBuildCommand": "npm run build:web && npm run tauri:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Git Squash UI",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server": "server",
      "../scripts": "scripts",
      "../dist": "dist",
      "./.tauri-runtime/node_modules": "node_modules",
      "./.tauri-runtime/defaults": "defaults"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
